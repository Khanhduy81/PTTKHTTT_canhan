<div class="row justify-content-center">
  <div class="col-md-7 col-lg-5">
    <div class="card">
      <div class="card-body p-4 p-md-5">
        <div class="text-center mb-4">
          <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-primary bg-opacity-10 text-primary mb-3" style="width:3.25rem;height:3.25rem;font-size:1.4rem;">
            <i class="bi bi-person-plus"></i>
          </span>
          <h1 class="h4 mb-1">Tạo tài khoản</h1>
          <p class="text-muted small mb-0">Mua laptop & linh kiện chính hãng, bảo hành điện tử</p>
        </div>

        <% if (errors && errors.length) { %>
          <div class="alert alert-danger">
            <ul class="mb-0 ps-3">
              <% errors.forEach(function (msg) { %><li><%= msg %></li><% }) %>
            </ul>
          </div>
        <% } %>

        <form method="post" action="/register">
          <div class="mb-3">
            <label class="form-label" for="reg-fullname">Họ và tên</label>
            <div class="input-group">
              <span class="input-group-text bg-white"><i class="bi bi-person"></i></span>
              <input id="reg-fullname" name="fullName" class="form-control" required autofocus value="<%= old.fullName || '' %>">
            </div>
          </div>
          <div class="row">
            <div class="col-6 mb-3">
              <label class="form-label" for="reg-username">Tên đăng nhập</label>
              <input id="reg-username" name="username" class="form-control" required value="<%= old.username || '' %>">
            </div>
            <div class="col-6 mb-3">
              <label class="form-label" for="reg-phone">Số điện thoại</label>
              <input id="reg-phone" name="phone" class="form-control" required placeholder="09xxxxxxxx" value="<%= old.phone || '' %>">
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label" for="reg-email">Email <span class="text-muted">(không bắt buộc)</span></label>
            <div class="input-group">
              <span class="input-group-text bg-white"><i class="bi bi-envelope"></i></span>
              <input id="reg-email" name="email" type="email" class="form-control" value="<%= old.email || '' %>">
            </div>
          </div>
          <div class="row">
            <div class="col-6 mb-3">
              <label class="form-label" for="reg-password">Mật khẩu</label>
              <input id="reg-password" name="password" type="password" class="form-control" required minlength="6">
            </div>
            <div class="col-6 mb-3">
              <label class="form-label" for="reg-confirm">Nhập lại mật khẩu</label>
              <input id="reg-confirm" name="confirmPassword" type="password" class="form-control" required minlength="6">
            </div>
          </div>
          <button class="btn btn-primary w-100 py-2 d-flex align-items-center justify-content-center gap-2 mt-2">
            Đăng ký <i class="bi bi-arrow-right"></i>
          </button>
        </form>
        <p class="text-center small mt-3 mb-0">Đã có tài khoản? <a href="/auth/login">Đăng nhập</a></p>
      </div>
    </div>
  </div>
</div>
