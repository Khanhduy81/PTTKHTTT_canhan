<div class="card todo-card">
  <div class="card-body p-4">
    <div class="d-flex align-items-center gap-3 mb-3">
      <span class="todo-icon"><i class="bi bi-cone-striped"></i></span>
      <div>
        <div class="text-uppercase small fw-bold text-warning-emphasis">Chưa triển khai</div>
        <h2 class="h5 mb-0"><%= info.title %></h2>
      </div>
      <span class="badge text-bg-dark ms-auto"><%= info.module %></span>
    </div>
    <p class="text-muted mb-3"><span class="part-no"><%= info.route %></span> · <%= info.owner %></p>
    <% if (info.tasks && info.tasks.length) { %>
      <h3 class="h6">Việc cần làm</h3>
      <ul class="mb-3"><% info.tasks.forEach(function (t) { %><li><%= t %></li><% }) %></ul>
    <% } %>
    <dl class="row small mb-0 border-top pt-3">
      <% if (info.db) { %><dt class="col-sm-3 text-muted">Bảng / proc / view DB</dt><dd class="col-sm-9"><%= info.db %></dd><% } %>
      <% if (info.rubric) { %><dt class="col-sm-3 text-muted">Mục barem liên quan</dt><dd class="col-sm-9"><%= info.rubric %></dd><% } %>
      <dt class="col-sm-3 text-muted">Controller</dt><dd class="col-sm-9"><code><%= info.controller %></code></dd>
      <dt class="col-sm-3 text-muted">View gợi ý</dt><dd class="col-sm-9"><code><%= info.view %></code></dd>
    </dl>
  </div>
</div>
