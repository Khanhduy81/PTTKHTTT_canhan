<div class="row g-3 mb-4">
  <% [['Tài khoản', stats.accounts, 'bi-people', 'primary'], ['Đang bị khoá', stats.lockedAccounts, 'bi-lock', 'danger'], ['Vai trò', stats.roles, 'bi-key', 'success'], ['Log 24 giờ', stats.logs24h, 'bi-journal-text', 'info']].forEach(function (c) { %>
    <div class="col-6 col-lg-3"><div class="card stat-card border-<%= c[3] %>"><div class="card-body d-flex justify-content-between align-items-center">
      <div><div class="text-muted small"><%= c[0] %></div><div class="fs-3 fw-bold"><%= c[1] %></div></div><i class="bi <%= c[2] %> fs-1 text-<%= c[3] %>"></i>
    </div></div></div>
  <% }) %>
</div>
<div class="card"><div class="card-header">Hoạt động gần đây</div>
  <table class="table table-sm mb-0"><thead><tr><th>Thời gian</th><th>Người dùng</th><th>Hành động</th><th>Chi tiết</th></tr></thead><tbody>
    <% recent.forEach(function (l) { %><tr><td><%= fmtDateTime(l.CreatedAt) %></td><td><%= l.Username || 'hệ thống' %></td><td><span class="badge text-bg-secondary"><%= l.Action %></span> <%= l.EntityName || '' %></td><td><%= l.Detail || '' %></td></tr><% }) %>
    <% if (!recent.length) { %><tr><td colspan="4" class="text-center text-muted">Chưa có log</td></tr><% } %>
  </tbody></table>
</div>
